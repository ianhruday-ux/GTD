# The Capacitor shell (chunk W0). What is versioned here is the SHELL — the
# handful of files that make dist/index.html into an installable app. Everything
# generated is ignored, because it is reproducible from `npm install` and
# `npx cap sync` and would otherwise bury the two files that actually matter
# (MainActivity.java and capacitor.config.json) under tens of thousands of
# lines of build output.

node_modules/

# Gradle's working state and outputs
android/.gradle/
android/build/
android/app/build/
android/captures/
android/.idea/
android/local.properties

# ⚠ COPIED FROM dist/, NOT AUTHORED HERE. `npx cap sync` refreshes this from the
# repo's real build, which is the whole point of pointing webDir at ../dist —
# the wrapper wraps the actual product rather than a copy that can drift.
# Committing it would mean dist/index.html lived in git twice, out of step.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# Generated by the Capacitor CLI on every sync
android/capacitor-cordova-android-plugins/
android/app/src/main/res/xml/config.xml
